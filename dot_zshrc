# ~/.zshrc: Johan Kyu Kim Espinosa
HISTFILE=~/.zsh_history; HISTSIZE=5000; SAVEHIST=5000
setopt APPEND_HISTORY HIST_IGNORE_DUPS SHARE_HISTORY
autoload -Uz compinit && compinit
zstyle ':completion:*' menu select
bindkey -e
for p in /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh /usr/share/zsh/site-functions/zsh-autosuggestions.zsh; do [ -r "$p" ] && source "$p" && break; done
for p in /usr/share/zsh/plugins/zsh-history-substring-search/zsh-history-substring-search.zsh; do [ -r "$p" ] && source "$p" && bindkey '^[[A' history-substring-search-up && bindkey '^[[B' history-substring-search-down && break; done
for p in /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh; do [ -r "$p" ] && source "$p" && break; done
PS1='%F{magenta}>%f %F{blue}%~%f '
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.cargo/bin:$PATH"

alias rice='~/.local/share/chezmoi/rice-commit.sh'
